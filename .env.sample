# ==================================
# -----[Database configuration]-----
# ==================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=distributed_wagering

# LocalStack / AWS SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localstack:4566
SQS_OPERATION_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_QUEUE_NAME=wager-transactions-dlq.fifo
SQS_OUTBOX_QUEUE_NAME=wagering-events.fifo
SQS_OPERATION_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_OUTBOX_QUEUE_URL=http://localstack:4566/000000000000/wagering-events.fifo
SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
SQS_LONG_POLL_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_MAX_RECEIVE_COUNT=5
OUTBOX_BATCH_SIZE=10
OUTBOX_CLAIM_LEASE_MS=60000
